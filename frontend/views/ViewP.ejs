<% layout("/layouts/boilerplate") -%>

<section class="post-details">
    <div class="post-details-top">
        <div>
            <span class="eyebrow">PROPERTY DETAILS</span>
            <h1>Review this place before getting in touch.</h1>
        </div>
        <a href="<%= backUrl %>" class="btn btn-light">← Back</a>
    </div>

    <div class="post-details-shell">
        <% if (Showpost.images && Showpost.images.length > 0) { %>
            <div class="post-details-gallery">
                <div id="viewPostCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <% Showpost.images.forEach((image, index) => { %>
                            <div class="carousel-item <%= index === 0 ? 'active' : '' %>"><img src="<%= image.url %>" class="d-block w-100 post-details-image" alt="Post image"></div>
                        <% }) %>
                    </div>
                    <% if (Showpost.images.length > 1) { %>
                        <button class="carousel-control-prev" type="button" data-bs-target="#viewPostCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
                        <button class="carousel-control-next" type="button" data-bs-target="#viewPostCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
                    <% } %>
                </div>
            </div>
        <% } else { %>
            <div class="post-no-image">No image provided</div>
        <% } %>

        <div class="post-details-body">
            <h1 class="post-title"><%= Showpost.Title %></h1>
            <div class="details-summary">
                <div><span class="rm-property-type"><%= Showpost.PostType %></span><h2>₹<%= Showpost.Rent %> <span>/ month</span></h2></div>
                <button type="button" class="btn btn-light share-button" id="sharePostBtn">🔗 Share Post</button>
            </div>

            <div class="detail-grid">
                <div class="detail-item"><span>Post Owner</span><strong><%= Showpost.owner.Name %></strong></div>
                <div class="detail-item"><span>Location</span><strong><%= Showpost.Location.adress %></strong></div>
                <div class="detail-item"><span>Gender Preference</span><strong><%= Showpost.GenderPreferance %></strong></div>
                <div class="detail-item"><span>Contact Number</span><strong><%= Showpost.contactNumber %></strong></div>
                <% if (Showpost.Email) { %><div class="detail-item"><span>Email</span><strong><%= Showpost.Email %></strong></div><% } %>
                <div class="detail-item"><span>AC</span><strong><%= Showpost.Description && Showpost.Description[0] ? Showpost.Description[0].AC : false %></strong></div>
                <div class="detail-item"><span>Furnishing</span><strong><%= Showpost.Description && Showpost.Description[0] ? Showpost.Description[0].Furnishing : false %></strong></div>
                <div class="detail-item"><span>Posted On</span><strong><%= Showpost.createdAt.toLocaleDateString() %></strong></div>
            </div>

            <div class="detail-long">
                <div><span>Rules</span><p><%= Showpost.Rules || "No rules provided" %></p></div>
                <div><span>Location</span><p><%= Showpost.Location.adress %> <% if (Showpost.Location.url) { %><a href="<%= Showpost.Location.url %>" target="_blank">Open in GMap ↗</a><% } %></p></div>
            </div>

            <div class="detail-contact-actions">
                <a href="tel:<%= Showpost.contactNumber %>" class="btn btn-success">📞 Call Owner</a>
                <% if (Showpost.Email) { %><a href="mailto:<%= Showpost.Email %>" class="btn btn-outline-primary">✉️ Email Owner</a><% } %>
                <% if (isFavorite) { %>
                    <form action="/post/<%= Showpost._id %>/favorite?_method=DELETE&back=<%= encodeURIComponent(backUrl) %>" method="POST" class="d-inline"><button type="submit" class="btn btn-danger">💛 Remove Favorite</button></form>
                <% } else { %>
                    <form action="/post/<%= Showpost._id %>/favorite?back=<%= encodeURIComponent(backUrl) %>" method="POST" class="d-inline"><button type="submit" class="btn btn-warning">⭐ Add Favorite</button></form>
                <% } %>
            </div>
        </div>
    </div>
</section>